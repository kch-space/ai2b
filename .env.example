# 可选：非交互初始化。推荐直接启动终端配置向导。
# 本地：python3 app.py；Docker：docker compose run --rm ai2b --configure。
# 模型留空时仍可使用规则报告，AI 对话需要模型配置。
# 密钥由 Python 服务读取，不提交到 Git。

AI2B_LLM_BASE_URL=
AI2B_LLM_MODEL=
AI2B_LLM_API_KEY=

# 从 @BotFather 创建机器人，先向它发送 /start。
# Chat ID 可为个人 ID 或群组负数 ID。
AI2B_TELEGRAM_BOT_TOKEN=
AI2B_TELEGRAM_CHAT_ID=

# 群聊必须限定可操作用户，私聊可选。使用数字 Telegram 用户 ID，逗号分隔。
AI2B_TELEGRAM_ALLOWED_USER_IDS=
AI2B_MONITOR_WINDOW_MINUTES=15
AI2B_MONITOR_CHANGE_PCT=2
AI2B_MONITOR_COOLDOWN_MINUTES=30
AI2B_MONITOR_REPORT_MINUTES=240
# 每个 UTC 日，Telegram AI 请求上限；失败也计数，重启不重置。
AI2B_TELEGRAM_DAILY_AI_CALLS=50
