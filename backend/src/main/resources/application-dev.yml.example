# Copy to application-dev.yml; replace placeholders with local development values.
# Loaded from the classpath; application.yml defaults to the dev profile.
spring:
  datasource:
    url: 'jdbc:mysql://127.0.0.1:3306/crypto_intelligence?sslMode=REQUIRED&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&preserveInstants=true&rewriteBatchedStatements=true&characterEncoding=UTF-8&connectTimeout=5000&socketTimeout=10000'
    username: 'replace_with_database_user'
    password: 'replace_with_database_password'

market:
  binance:
    rest-base-url: 'https://fapi.binance.com'
    api-key: 'replace_with_your_api_key'
    api-secret: 'replace_with_your_api_secret'
  instruments:
    sync-enabled: true
  klines:
    enabled: true
  metrics:
    enabled: true
