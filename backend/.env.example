# Optional environment reference for non-dev deployments; scripts do not load .env files.
# Local development uses src/main/resources/application-dev.yml.example instead.
# Never commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crypto_intelligence
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_database_password
# Optional: background metadata sync (manual sync remains available)
# INSTRUMENT_SYNC_ENABLED=true
# Optional: background closed 1m candle collection (manual collection remains available)
# KLINE_COLLECTION_ENABLED=true
# Optional: background OI/funding/ratio collection (manual collection remains available)
# METRIC_COLLECTION_ENABLED=true
# BINANCE_REST_BASE_URL=https://fapi.binance.com
# Optional: API Key is used by top-trader ratio endpoints; Secret is reserved for signed account requests.
# BINANCE_API_KEY='replace_with_your_api_key'
# BINANCE_API_SECRET='replace_with_your_api_secret'
