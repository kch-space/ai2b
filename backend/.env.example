# Copy to .env.local for the Mac scripts; Spring Boot itself does not load .env files.
# Never commit real credentials. Quote shell-special characters in .env.local.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crypto_intelligence
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_database_password
# Optional: background metadata sync (manual sync remains available)
# INSTRUMENT_SYNC_ENABLED=true
# BINANCE_REST_BASE_URL=https://fapi.binance.com
